LOCAL_MONGODB_URI=mongodb://localhost:62262/?directConnection=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

DB_NAME=portfolio_rag
LOCAL_COLLECTION_NAME=portfolio_knowledge_local
CHAT_HISTORY_COLL=portfolio_chat_history
VECTOR_INDEX_NAME=vector_index
TEXT_INDEX_NAME=text_index
RETRIEVAL_MODE=baseline
DEFAULT_RETRIEVAL_MODE=baseline
DEFAULT_CHUNK_MODE=auto
RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_CANDIDATE_LIMIT=12
EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_LOCAL_ONLY=false

# Cloud-only values belong in .env.local or Vercel Environment Variables.
MONGODB_URI=
GEMINI_API_KEY=
CLOUD_DB_NAME=portfolio_rag
CLOUD_COLLECTION_NAME=portfolio_knowledge_public
CLOUD_VECTOR_INDEX_NAME=vector_index_public
CLOUD_TEXT_INDEX_NAME=text_index_public
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Owner-only Publish Studio (Clerk). Keep registration disabled in Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
OWNER_EMAILS=
CLOUD_DOCUMENTS_COLLECTION_NAME=portfolio_public_documents
CLOUD_DRAFTS_COLLECTION_NAME=portfolio_public_drafts
CLOUD_METADATA_COLLECTION_NAME=portfolio_public_metadata
